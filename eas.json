{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ENVIRONMENT": "sandbox"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_ENVIRONMENT": "sandbox"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ENVIRONMENT": "prod"
      },
      "ios": {
        "distribution": "store"
      },
      "android": {
        "distribution": "internal"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6809510227"
      }
    }
  }
}
