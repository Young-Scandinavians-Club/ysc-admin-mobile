{
  "expo": {
    "name": "YSC Admin",
    "slug": "ysc-admin",
    "owner": "young-scandinavians-club",
    "version": "1.2.0",
    "scheme": "ysc-admin",
    "primaryColor": "#144993",
    "backgroundColor": "#ffffff",
    "web": {
      "name": "YSC Admin",
      "themeColor": "#144993",
      "backgroundColor": "#ffffff",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-dev-client",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "appDelegate": true,
          "tapToPayCheck": true,
          "locationWhenInUsePermission": "YSC Admin uses your location to connect to Stripe Tap to Pay and to card readers.",
          "bluetoothPeripheralPermission": "YSC Admin uses Bluetooth to connect to supported card readers.",
          "bluetoothAlwaysUsagePermission": "YSC Admin uses Bluetooth to connect to supported card readers.",
          "localNetworkUsagePermission": "YSC Admin uses the local network to connect to supported card readers."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.ysc.admin",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "org.ysc.admin",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "ysc.org",
              "pathPrefix": "/app/auth-callback"
            },
            {
              "scheme": "https",
              "host": "ysc-sandbox.fly.dev",
              "pathPrefix": "/app/auth-callback"
            }
          ]
        }
      ]
    },
    "extra": {
      "eas": {
        "projectId": "271c1a73-4e31-417f-8b74-e84809dec67c"
      }
    }
  }
}
